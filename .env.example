# Local database configuration template.
#
# Copy this file to `.env` and adjust values if needed:
#
#   cp .env.example .env
#
# `.env` is git-ignored and MUST NOT be committed.
# The values below are local-only, non-secret defaults. Never reuse them
# outside of local development.

POSTGRES_USER=educator
POSTGRES_PASSWORD=educator_local_pw
POSTGRES_DB=educator
POSTGRES_PORT=5432
