# Local database configuration template.
#
# Copy this file to `.env` and adjust values if needed:
#
#   cp .env.example .env
#
# `.env` is git-ignored and MUST NOT be committed.
# The values below are local-only, non-secret defaults. Never reuse them
# outside of local development.

POSTGRES_USER=educator
POSTGRES_PASSWORD=educator_local_pw
POSTGRES_DB=educator
POSTGRES_PORT=5432

# Bootstrap admin (required by `npm run db:migrate`; no default is committed).
# Set strong local-only values in your `.env` before migrating.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=

# Safety override for `npm run db:reset`. Reset refuses to run unless the
# database host is loopback (127.0.0.1, localhost, ::1). Set this to "true"
# only if you really intend to drop schemas on a non-local database.
# ALLOW_DESTRUCTIVE_DB_RESET=true
